# Скопируйте этот файл в .env и заполните реальными значениями.
# Не коммитьте .env с реальными секретами.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB (путь для персистентного хранения векторной базы знаний)
CHROMA_PERSIST_DIR=./data/chroma

# Параметры генерации LLM (значения выбраны по результатам экспериментов, см. EVALS.md)
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_MAX_TOKENS=4096

# LangSmith: трассировка LLM-вызовов, этапов LangGraph, RAG и MCP (опционально).
# Ключ: https://smith.langchain.com -> Settings -> API Keys. Прежние имена LANGCHAIN_* тоже работают.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=processmind-ai
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # только для EU-региона или self-hosted

# MCP
MCP_SERVER_NAME=processmind-mcp

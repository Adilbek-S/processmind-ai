# Скопируйте этот файл в .env и заполните реальными значениями.
# Не коммитьте .env с реальными секретами.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB (путь для персистентного хранения векторной базы знаний)
CHROMA_PERSIST_DIR=./data/chroma

# LangSmith / LangChain tracing (опционально)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=processmind-ai

# MCP
MCP_SERVER_NAME=processmind-mcp
